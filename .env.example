# Example environment variables for USSpending RAG project
# Copy to .env and fill in any secrets (e.g. LANGSMITH_API_KEY)

# LangSmith tracing (optional) — add your key if you use LangSmith
export LANGSMITH_TRACING=true
export LANGSMITH_ENDPOINT=https://api.smith.langchain.com
export LANGSMITH_API_KEY=
export LANGSMITH_PROJECT=

# Anthropic API (required for answer synthesis)
export ANTHROPIC_API_KEY=
# Only needed for an identity-linked API key (Console shows a
# "workspace required" error otherwise) — find it under Settings > Workspaces
export ANTHROPIC_WORKSPACE_ID=

# Vector DB storage directory for Chroma
CHROMA_DB_DIR=./data/chroma

# Whoosh index directory for BM25 sparse index
WHOOSH_INDEX_DIR=./data/whoosh

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Cross-encoder reranker model (sentence-transformers cross-encoder)
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Local dev settings
LOG_LEVEL=info
